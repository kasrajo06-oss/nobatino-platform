# ============================================================
#  Copy to infra/.env on the server and fill in.  (cp .env.example .env)
# ============================================================

# ---- site ----
DOMAIN=example.ir
LETSENCRYPT_EMAIL=admin@example.ir
BRAND_NAME=نوبتینو
SUPPORT_PHONE=021-00000000

# ---- staging (private test site) ----
# true  = site behind username/password, hidden from Google, OTP shown on screen, fake payment
# false = public production (requires real SMS + Zarinpal)
STAGING=true
# load fake doctors/centers for demo (only works when STAGING=true)
SEED_FAKE_DATA=true
BASIC_AUTH_USER=team
BASIC_AUTH_PASSWORD=change-me-staging

# ---- database / secrets ----
POSTGRES_DB=doctor
POSTGRES_USER=doctor
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-too

# ---- payment (Zarinpal) — leave fake while STAGING=true ----
PAYMENT_GATEWAY=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# ---- SMS — console while STAGING=true; later Kavenegar or sms.ir ----
SMS_BACKEND=apps.notifications.sms.ConsoleSmsBackend
# SMS_BACKEND=apps.notifications.sms.KavenegarSmsBackend
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
# SMS_BACKEND=apps.notifications.sms.SmsIrBackend
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=0
SMSIR_LINE_NUMBER=

# ---- video/phone consultation relay (open UDP 3478 + 49160-49200) ----
TURN_USER=consult
TURN_PASSWORD=change-me-turn

# ---- build mirrors (useful on servers inside Iran) ----
# Leave the defaults if the server can reach Docker Hub / PyPI / npm directly.
PY_IMAGE=python:3.12-slim
NODE_IMAGE=node:22-alpine
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org/
APT_MIRROR=

SENTRY_DSN=
