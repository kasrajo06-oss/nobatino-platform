# Copy to infra/.env and fill in. Used by docker-compose.prod.yml.
DOMAIN=example.ir
BRAND_NAME=نوبتینو
SUPPORT_PHONE=021-00000000

POSTGRES_DB=doctor
POSTGRES_USER=doctor
POSTGRES_PASSWORD=change-me

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
JWT_COOKIE_DOMAIN=

# Payments (Zarinpal) and SMS (Kavenegar) are required in production
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# SMS: Kavenegar or sms.ir
SMS_BACKEND=apps.notifications.sms.KavenegarSmsBackend
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
# SMS_BACKEND=apps.notifications.sms.SmsIrBackend
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_LINE_NUMBER=

# TURN server for online phone/video consultations (open UDP 3478 and 49160-49200 on the firewall)
TURN_USER=consult
TURN_PASSWORD=change-me-turn

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-too
SENTRY_DSN=
