# Rendered by the nginx image (envsubst): ${DOMAIN}, ${BASIC_AUTH}, ${ROBOTS_TAG}.
# Certificates come from Let's Encrypt (scripts/init-ssl.sh) under /etc/letsencrypt/live/${DOMAIN}/.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;

upstream frontend_app { server frontend:3000; }
upstream backend_app { server backend:8000; }

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://${DOMAIN}$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    return 301 https://${DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 15m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;
    add_header X-Robots-Tag "${ROBOTS_TAG}" always;

    # staging: username/password for the whole site ("off" in production)
    auth_basic "${BASIC_AUTH}";
    auth_basic_user_file /etc/nginx/htpasswd;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location /api/auth/otp/ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://backend_app;
    }

    # the bank redirects the browser here; must stay reachable even when staging auth is on
    location /api/payments/callback {
        auth_basic off;
        proxy_pass http://backend_app;
    }

    location /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://backend_app;
    }

    location /admin/ { proxy_pass http://backend_app; }

    location /static/ {
        proxy_pass http://backend_app;
        expires 30d;
    }

    location /media/ {
        proxy_pass http://minio:9000/media/;
        expires 7d;
    }

    location /_next/static/ {
        proxy_pass http://frontend_app;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://frontend_app;
    }
}
